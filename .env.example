# Runtime aplikasi (Vercel/serverless) → Transaction pooler, port 6543
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres"

# Migration → Direct connection (5432) bila jaringan mendukung IPv6; kalau tidak, pakai Session pooler (5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"

# Secret untuk menandatangani JWT admin (string acak panjang)
JWT_SECRET=<random-string-panjang>
